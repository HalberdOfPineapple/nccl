# NVLink packet bytes and link busy cycles (R1-R5 attempt) for RCA plan 01, GH100. Used only if E1.3 shows nsys accepts the cycle counters.
# Same counter ids as the built-in gh100 set, but with the .sum suffix (bytes per sample), because the
# built-in percentages are exported as whole numbers. No schedulingRule, so a counter that cannot be
# scheduled makes the profile fail instead of being dropped silently.
version: 5
metricSets:
- alias: nvlink_cycles
  name: NVLink packet bytes and busy cycles (RCA plan 01, R5 attempt)
  chips: [GH100]
  displayRows:
  - name: NVLink RX Bytes
    type: stacked
    metrics:
    - NVLink RX Requests Protocol Data
    - NVLink RX Requests User Data
    - NVLink RX Responses Protocol Data
    - NVLink RX Responses User Data
  - name: NVLink TX Bytes
    type: stacked
    metrics:
    - NVLink TX Requests Protocol Data
    - NVLink TX Requests User Data
    - NVLink TX Responses Protocol Data
    - NVLink TX Responses User Data
  metrics:
  - name: NVLink RX Requests Protocol Data
    id: NVLRX.TriageCompute.nvlrx__bytes_packet_request_data_protocol
    color: '#C79536'
    subMetrics:
    - name: Bytes
      suffix: .sum
  - name: NVLink RX Requests User Data
    id: NVLRX.TriageCompute.nvlrx__bytes_packet_request_data_user
    color: '#FFD179'
    subMetrics:
    - name: Bytes
      suffix: .sum
  - name: NVLink RX Responses Protocol Data
    id: NVLRX.TriageCompute.nvlrx__bytes_packet_response_data_protocol
    color: '#2E7D32'
    subMetrics:
    - name: Bytes
      suffix: .sum
  - name: NVLink RX Responses User Data
    id: NVLRX.TriageCompute.nvlrx__bytes_packet_response_data_user
    color: '#81C784'
    subMetrics:
    - name: Bytes
      suffix: .sum
  - name: NVLink TX Requests Protocol Data
    id: NVLTX.TriageCompute.nvltx__bytes_packet_request_data_protocol
    color: '#1565C0'
    subMetrics:
    - name: Bytes
      suffix: .sum
  - name: NVLink TX Requests User Data
    id: NVLTX.TriageCompute.nvltx__bytes_packet_request_data_user
    color: '#64B5F6'
    subMetrics:
    - name: Bytes
      suffix: .sum
  - name: NVLink TX Responses Protocol Data
    id: NVLTX.TriageCompute.nvltx__bytes_packet_response_data_protocol
    color: '#6A1B9A'
    subMetrics:
    - name: Bytes
      suffix: .sum
  - name: NVLink TX Responses User Data
    id: NVLTX.TriageCompute.nvltx__bytes_packet_response_data_user
    color: '#BA68C8'
    subMetrics:
    - name: Bytes
      suffix: .sum
  - name: NVLink RX Cycles Active
    id: NVLRX.TriageCompute.nvlrx__cycles_active
    color: '#999999'
    subMetrics:
    - name: Cycles
      suffix: .sum
  - name: NVLink RX Cycles Elapsed
    id: NVLRX.TriageCompute.nvlrx__cycles_elapsed
    color: '#777777'
    subMetrics:
    - name: Cycles
      suffix: .sum
  - name: NVLink TX Cycles Active
    id: NVLTX.TriageCompute.nvltx__cycles_active
    color: '#555555'
    subMetrics:
    - name: Cycles
      suffix: .sum
  - name: NVLink TX Cycles Elapsed
    id: NVLTX.TriageCompute.nvltx__cycles_elapsed
    color: '#333333'
    subMetrics:
    - name: Cycles
      suffix: .sum
